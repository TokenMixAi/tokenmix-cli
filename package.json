{
  "name": "tokenmix",
  "version": "1.5.2",
  "description": "Zero-config CLI to use any open-source coding agent with TokenMix as the unified LLM backend.",
  "type": "module",
  "bin": {
    "tokenmix": "./bin/tokenmix.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node bin/tokenmix.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "tokenmix",
    "ai",
    "agent",
    "cli",
    "opencode",
    "claude-code",
    "aider",
    "kilo",
    "cline",
    "roo-code",
    "continue",
    "codex",
    "qwen-code",
    "goose",
    "openhands",
    "coding-agent"
  ],
  "author": "TokenMix",
  "license": "MIT",
  "homepage": "https://tokenmix.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/TokenMixAi/tokenmix-cli.git"
  },
  "bugs": {
    "url": "https://github.com/TokenMixAi/tokenmix-cli/issues"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "axios": "^1.7.7",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "fs-extra": "^11.2.0",
    "open": "^10.1.0",
    "prompts": "^2.4.2",
    "which": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.9.0",
    "@types/prompts": "^2.4.9",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
